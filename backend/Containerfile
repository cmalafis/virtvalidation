# Default base — matches our standalone podman-compose deployment.
# For FIPS 140-3 deployments (federal customers, FedRAMP), swap this
# line for the Red Hat UBI Python image and run on a FIPS-enabled
# host so the bundled OpenSSL operates in FIPS mode automatically:
#
#     FROM registry.access.redhat.com/ubi9/python-312:latest
#
# UBI alone does NOT make the deployment FIPS-compliant — the host OS
# (RHEL 8/9 with `fips-mode-setup --enable`, or RHCOS deployed with
# `fips: true`) is what activates the FIPS-validated cryptography.
# See docs/FIPS_DEPLOYMENT.md for the full requirements.
FROM docker.io/python:3.12-slim
WORKDIR /app
# weasyprint runtime needs Pango / Cairo / GDK-Pixbuf to render PDF.
RUN apt-get update && apt-get install -y --no-install-recommends \
        openssh-client \
        libpango-1.0-0 \
        libpangoft2-1.0-0 \
        libcairo2 \
        libgdk-pixbuf-2.0-0 \
        shared-mime-info \
        fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

# Build context is the repo root (see podman-compose.yml). Everything below
# is namespaced under backend/ except the CSV template which lives in docs/.
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY backend/app/ ./app/
COPY backend/migrations/ ./migrations/
COPY backend/alembic.ini ./alembic.ini

# Static assets the API serves directly (CSV inventory template, etc.).
# CSV_TEMPLATE_PATH defaults to /app/templates/vm-inventory-template.csv.
COPY docs/vm-inventory-template.csv /app/templates/vm-inventory-template.csv

RUN mkdir -p /app/keys && chmod 700 /app/keys
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
