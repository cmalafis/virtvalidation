# Red Hat UBI 9 Python 3.12 — the supported base for VirtValidate
# images. UBI is required for federal customer security reviews and
# is the only path that can pair with a FIPS-enabled host kernel to
# produce a FIPS-validated runtime. See docs/CONTAINER_IMAGES.md and
# docs/FIPS_DEPLOYMENT.md for the full requirements.
FROM registry.access.redhat.com/ubi9/python-312@sha256:69047002cca0357b0ebf4fd95c29eff7d357e7b906807af0d9b5c62783074ce0 AS runtime

# Build args allow CI to inject version and SHA without rebuilding the
# whole image on every commit (BuildKit layer caching keeps the
# microdnf and pip layers warm). We use IMAGE_VERSION instead of the
# more natural VERSION because several UBI bases (notably ubi9/nginx-124
# which sets ENV VERSION=0) export a colliding env var that wins over
# ARG during LABEL substitution. Standardizing on IMAGE_VERSION across
# all Containerfiles keeps both variants honest.
ARG IMAGE_VERSION=0.1.0-dev
ARG VCS_REF=unknown

LABEL org.opencontainers.image.title="virtvalidate-backend" \
      org.opencontainers.image.description="VirtValidate FastAPI backend" \
      org.opencontainers.image.version="${IMAGE_VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.source="https://github.com/virtvalidate/virtvalidate" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.base.name="registry.access.redhat.com/ubi9/python-312@sha256:69047002cca0357b0ebf4fd95c29eff7d357e7b906807af0d9b5c62783074ce0"

# UBI Python ships a default user (UID 1001, GID 0) that owns
# /opt/app-root. Convention is to run as that user with the working
# directory at /opt/app-root/src. openssh-clients drives the SSH
# collector. PDF rendering is pure Python (xhtml2pdf + ReportLab) so
# we no longer install pango/cairo/gdk-pixbuf/fonts — see PR #12,
# which dropped weasyprint to unblock the hardened Hummingbird image
# and also shrink the standard image's attack surface.
USER 0
RUN dnf install -y openssh-clients \
    && dnf clean all \
    && rm -rf /var/cache/yum /var/cache/dnf

WORKDIR /opt/app-root/src

# Build context is the repo root (see podman-compose.yml). Everything
# below is namespaced under backend/ except the CSV template which
# lives in docs/. /opt/app-root/src is owned by UID 1001 / GID 0; pip
# installs into the UBI default site without needing a virtualenv
# managed in the Containerfile.
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY backend/app/ ./app/
COPY backend/migrations/ ./migrations/
COPY backend/alembic.ini ./alembic.ini

# Static assets the API serves directly (CSV inventory template,
# etc.). Lives at /opt/app-root/src/templates and at /app/templates
# (via the symlink below) — settings default to /app/templates.
COPY docs/vm-inventory-template.csv ./templates/vm-inventory-template.csv

# Ansible playbooks served by GET /api/ssh-keys/{id}/playbook. The
# handler resolves the file via the repo-relative path
# ``parents[3] / "deploy" / "ansible" / ...`` — so copying the tree
# into ../deploy keeps the parents[3] resolution working both in dev
# (where the repo root has deploy/) and in the container (where
# /opt/app-root/deploy mirrors it). Without this the endpoint returns
# 503 because the file doesn't exist at the expected path.
COPY deploy/ansible/ /opt/app-root/deploy/ansible/

# SSH key directory + back-compat /app symlink. The runtime defaults
# (SSH_KEY_PATH=/app/keys/id_ed25519, CSV_TEMPLATE_PATH=/app/templates)
# and the podman-compose / Quadlet volume mounts (./backend/app/keys
# → /app/keys) reference /app — symlinking it to the UBI convention
# directory means those mounts continue to work while the image
# itself follows Red Hat's layout. /app/keys mode 700 + group 0
# satisfies OpenShift's restricted-v2 SCC (arbitrary high UID with
# primary GID 0).
RUN mkdir -p /opt/app-root/src/keys \
    && ln -s /opt/app-root/src /app \
    && chgrp -R 0 /opt/app-root/src \
    && chmod -R g=u /opt/app-root/src \
    && chmod 700 /opt/app-root/src/keys

USER 1001

EXPOSE 8000

# Lightweight health probe — Kubernetes liveness/readiness use this
# same endpoint via the Helm chart. Falls under the in-pod boundary
# so it's always reachable without DNS or service mesh hops.
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8000/api/health/full > /dev/null || exit 1

# `--reload` is appropriate for the dev-mode podman-compose target
# (the bind-mounted source tree triggers reloads). The Helm chart
# deployment overrides this CMD via container args so production runs
# without the file-watcher overhead.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
