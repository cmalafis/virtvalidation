# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.venv-*/

# Tooling caches
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Test + coverage output
.coverage
coverage.xml
coverage.json
htmlcov/
pytest-output.txt

