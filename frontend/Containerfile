# --- build stage -----------------------------------------------------------
# Red Hat UBI 9 Node.js 20 — see docs/CONTAINER_IMAGES.md for the UBI
# rationale. UBI images run as UID 1001 by default; COPY brings files
# in with the host UID, which doesn't match. --chown=1001:0 keeps the
# UBI default user (1001 / GID 0) the owner so npm + vite can write
# their temp files in /opt/app-root/src/node_modules during the build.
FROM registry.access.redhat.com/ubi9/nodejs-20:latest AS builder
WORKDIR /opt/app-root/src
COPY --chown=1001:0 package*.json ./
RUN npm ci
COPY --chown=1001:0 . .
RUN npm run build

# --- runtime stage ---------------------------------------------------------
# UBI nginx 1.24 already runs as a non-root user (UID 1001 / GID 0)
# and listens on 8080 by default. That maps cleanly onto OpenShift's
# restricted-v2 SCC without the upstream nginx-unprivileged chmod
# gymnastics we used to need.
FROM registry.access.redhat.com/ubi9/nginx-124:latest

ARG VERSION=0.1.0-dev
ARG VCS_REF=unknown

LABEL org.opencontainers.image.title="virtvalidate-frontend" \
      org.opencontainers.image.description="VirtValidate React dashboard" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.source="https://github.com/virtvalidate/virtvalidate" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.base.name="registry.access.redhat.com/ubi9/nginx-124:latest"

# UBI nginx serves from /opt/app-root/src and reads its config from
# /etc/nginx/nginx.conf. We replace the stock config with a template
# rendered by ``entrypoint.sh`` at container start (so the same image
# works for podman-compose AND OpenShift without rebuilding the
# upstream service hostname into the binary). The SPA fall-through
# (try_files /index.html) + /api/ proxy live in the template.
USER 0
COPY --from=builder /opt/app-root/src/dist /opt/app-root/src
COPY nginx.conf.template /etc/nginx/nginx.conf.template
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chgrp -R 0 /opt/app-root/src /var/lib/nginx /var/log/nginx /etc/nginx /usr/local/bin/entrypoint.sh \
    && chmod -R g=u /opt/app-root/src /var/lib/nginx /var/log/nginx /etc/nginx /usr/local/bin/entrypoint.sh \
    && chmod +x /usr/local/bin/entrypoint.sh
USER 1001

# UBI nginx listens on 8080 by default. We expose 8080 here and
# update podman-compose.yml + the Helm chart's container port to
# match.
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8080/ > /dev/null || exit 1

# Entrypoint runs envsubst on the nginx.conf.template, recreates
# the /tmp/nginx/* directories (overlaid by the Helm chart's
# emptyDir mount), then exec's nginx in the foreground.
CMD ["/usr/local/bin/entrypoint.sh"]
