FROM registry.access.redhat.com/ubi9/nginx-124@sha256:1f87af5815e0056db802c1323dbe5dc0643602268b46b891c2d4bc1fc369f9f3

# IMAGE_VERSION not VERSION: ubi9/nginx-124 sets ENV VERSION=0 which
# clobbers ARG VERSION during LABEL substitution. See frontend/Containerfile.
ARG IMAGE_VERSION=0.1.0-dev
ARG VCS_REF=unknown

LABEL org.opencontainers.image.title="virtvalidate-frontend" \
      org.opencontainers.image.description="VirtValidate React dashboard" \
      org.opencontainers.image.version="${IMAGE_VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.source="https://github.com/virtvalidate/virtvalidate" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.base.name="registry.access.redhat.com/ubi9/nginx-124@sha256:1f87af5815e0056db802c1323dbe5dc0643602268b46b891c2d4bc1fc369f9f3"

# Runtime-only stage used by the cross-arch build path
# (scripts/build-images.sh on Apple Silicon → linux/amd64). The
# host runs ``npm run build`` natively so the QEMU-emulated esbuild
# crash is bypassed; this Containerfile just packages the already-
# built dist/ alongside the nginx config template + entrypoint.
USER 0
COPY dist/ /opt/app-root/src/
COPY nginx.conf.template /etc/nginx/nginx.conf.template
COPY entrypoint.sh /usr/local/bin/entrypoint.sh

RUN chgrp -R 0 /opt/app-root/src /etc/nginx /usr/local/bin/entrypoint.sh \
    && chmod -R g=u /opt/app-root/src /etc/nginx /usr/local/bin/entrypoint.sh \
    && chmod +x /usr/local/bin/entrypoint.sh
USER 1001

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8080/ > /dev/null || exit 1

# entrypoint.sh: envsubst nginx.conf.template, mkdir /tmp/nginx/*,
# exec nginx -g 'daemon off;'.
CMD ["/usr/local/bin/entrypoint.sh"]
