# Full nginx config template for the UBI nginx-124 image. UBI's
# default /etc/nginx/nginx.conf is replaced wholesale (rather than
# dropping in /etc/nginx/conf.d/default.conf) because the UBI base
# ships a minimal main config that doesn't include the conf.d glob —
# which meant our v0.1 conf.d/default.conf was silently ignored.
#
# Templated via envsubst at container start. ``entrypoint.sh`` reads
# this file, substitutes ${BACKEND_HOST} / ${BACKEND_PORT}, and
# writes the result to /etc/nginx/nginx.conf before exec'ing nginx.
# The two placeholders come from env vars set by:
#   - podman-compose.yml          (BACKEND_HOST=backend,           BACKEND_PORT=8000)
#   - deploy/helm/.../deployment-frontend.yaml (BACKEND_HOST=<release>-backend)
# nginx itself doesn't do env var substitution, which is why we
# template at start time instead. The same image works for both
# deployment modes without a rebuild.
#
# Listens on 8080 to match UBI's non-privileged convention.
#
# Temp paths target /tmp because the Helm chart mounts /var/lib/nginx
# and /run as emptyDir volumes — those mounts overlay (hide) any
# subdirectories baked into the image. /tmp is mounted as its own
# emptyDir, so it stays writable for an arbitrary OCP-assigned UID.
# ``entrypoint.sh`` recreates /tmp/nginx/{client_body,proxy,...}
# AFTER the mount, so these paths exist when nginx tries to use them.
worker_processes auto;
error_log /tmp/nginx-error.log notice;
pid /tmp/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    sendfile      on;
    keepalive_timeout 65;

    # All writable nginx state lives under /tmp so the Helm chart's
    # /var/lib/nginx and /run emptyDir mounts don't hide it.
    client_body_temp_path /tmp/nginx/client_body;
    proxy_temp_path       /tmp/nginx/proxy;
    fastcgi_temp_path     /tmp/nginx/fastcgi;
    uwsgi_temp_path       /tmp/nginx/uwsgi;
    scgi_temp_path        /tmp/nginx/scgi;

    access_log /tmp/nginx-access.log;

    # Reasonable upload ceiling for RVTools XLSX uploads (parsed
    # client-side normally, but oversize files still hit nginx).
    client_max_body_size 32M;

    server {
        listen 8080;
        server_name _;

        root /opt/app-root/src;
        index index.html;

        location / {
            try_files $uri $uri/ /index.html;
        }

        location /api/ {
            proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            # Background-task endpoints (categorize, generate plan)
            # may keep the connection open for several minutes.
            proxy_read_timeout 600s;
        }
    }
}
