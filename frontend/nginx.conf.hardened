# Static nginx configuration for the hardened frontend variant.
#
# The standard variant ships nginx.conf.template + entrypoint.sh and
# uses envsubst at startup to inject BACKEND_HOST / BACKEND_PORT from
# the Helm chart. Hardened images don't ship a shell or envsubst, so
# this config is fully static — the upstream is wired to the in-cluster
# backend Service DNS at the Helm default release name.
#
# Known limitation (documented in docs/SECURITY_POSTURE.md): when
# deploying the hardened variant, the Helm release name MUST be
# "virtvalidate" so the Service is named "virtvalidate-backend". If you
# need a different release name, set fullnameOverride: virtvalidate in
# your values.yaml so the chart still emits the expected Service name.

worker_processes auto;
error_log /tmp/nginx-error.log notice;
pid /tmp/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    sendfile      on;
    keepalive_timeout 65;

    # Hardened variant uses FLAT paths directly under /tmp rather than
    # the standard variant's /tmp/nginx/* hierarchy. The Helm chart
    # mounts /tmp as emptyDir, which wipes any baked-in subdirs, and
    # the standard variant's entrypoint.sh re-creates them at startup.
    # Hardened images don't ship a shell, so we rely on nginx's
    # auto-create-on-startup behavior — which creates the leaf
    # directory but NOT intermediate parents. Flat names under the
    # pre-existing /tmp let nginx create them itself.
    client_body_temp_path /tmp/nginx-client-body;
    proxy_temp_path       /tmp/nginx-proxy;
    fastcgi_temp_path     /tmp/nginx-fastcgi;
    uwsgi_temp_path       /tmp/nginx-uwsgi;
    scgi_temp_path        /tmp/nginx-scgi;

    access_log /tmp/nginx-access.log;

    # Reasonable upload ceiling for RVTools XLSX uploads (parsed
    # client-side normally, but oversize files still hit nginx).
    client_max_body_size 32M;

    server {
        listen 8080;
        server_name _;

        root /opt/app-root/src;
        index index.html;

        location / {
            try_files $uri $uri/ /index.html;
        }

        location /api/ {
            proxy_pass http://virtvalidate-backend:8000;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            # Background-task endpoints (categorize, generate plan)
            # may keep the connection open for several minutes.
            proxy_read_timeout 600s;
        }
    }
}
