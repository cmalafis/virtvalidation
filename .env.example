# VirtValidate environment — copy to `.env` and fill in real values.
# See docs/CONFIGURATION.md for what every variable controls.

# ---------- Backend ----------
DATABASE_URL=postgresql+psycopg2://virtvalidate:changeme@postgres:5432/virtvalidate
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3:8b
SSH_KEY_PATH=/app/keys/id_ed25519
CLUSTER_NAME=ocp-virt-prod-01

# Reserved for future signed-token auth. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me

# ---------- PostgreSQL ----------
POSTGRES_USER=virtvalidate
POSTGRES_PASSWORD=changeme
POSTGRES_DB=virtvalidate

# ---------- Frontend ----------
VITE_API_URL=http://localhost:8000
