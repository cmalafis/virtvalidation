# VirtValidate environment — copy to `.env` and fill in real values.
# See docs/CONFIGURATION.md for what every variable controls.

# ---------- Backend ----------
DATABASE_URL=postgresql+psycopg2://virtvalidate:changeme@postgres:5432/virtvalidate
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3:8b
SSH_KEY_PATH=/app/keys/id_ed25519
CLUSTER_NAME=ocp-virt-prod-01

# MTV / Forklift — referenced when generating wave migration YAML. The
# source and destination Provider resources must already exist in the
# target cluster.
MTV_NAMESPACE=openshift-mtv
MTV_SOURCE_PROVIDER=vmware
MTV_DESTINATION_PROVIDER=host
MTV_DEFAULT_TARGET_NAMESPACE=openshift-mtv

# CSV inventory template served by GET /api/templates/csv. Defaults to the
# container path populated by the Containerfile. For local dev (uvicorn
# from backend/), override to:
#   CSV_TEMPLATE_PATH=../docs/vm-inventory-template.csv
CSV_TEMPLATE_PATH=/app/templates/vm-inventory-template.csv

# Reserved for future signed-token auth. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me

# ---------- PostgreSQL ----------
POSTGRES_USER=virtvalidate
POSTGRES_PASSWORD=changeme
POSTGRES_DB=virtvalidate

# ---------- Frontend ----------
VITE_API_URL=http://localhost:8000
